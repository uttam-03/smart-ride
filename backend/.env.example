PORT=5000
# Generate a unique random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=7d

# SQLite is the zero-configuration default.
DB_DIALECT=sqlite
DB_STORAGE=./data/smartride.sqlite

# For MySQL, set DB_DIALECT=mysql and configure:
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=smartride
# DB_USER=root
# DB_PASSWORD=your-mysql-password
